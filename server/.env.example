# ==============================
# DATABASE
# ==============================

POSTGRES_DB=taxpreparertools
POSTGRES_USER=taxpreparertools
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_RANDOM_VALUE

DATABASE_URL=postgresql+psycopg://taxpreparertools:CHANGE_THIS_TO_A_STRONG_RANDOM_VALUE@db:5432/taxpreparertools

# ==============================
# ADMIN
# ==============================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_IMMEDIATELY

# ==============================
# DODO PAYMENTS
# ==============================
# Get these from the Dodo Payments dashboard (Developer -> API Keys / Webhooks).
# Use environment=test_mode while integrating, live_mode once you go live.

DODO_PAYMENTS_API_KEY=REPLACE_ME
DODO_PAYMENTS_WEBHOOK_KEY=REPLACE_ME
DODO_PAYMENTS_ENVIRONMENT=test_mode

# One product per plan, created in the Dodo dashboard.
# These are product_id values (pdt_...), NOT checkout links.

DODO_PRODUCT_BASIC_MONTHLY=pdt_REPLACE_BASIC_MONTHLY
DODO_PRODUCT_BASIC_ANNUAL=pdt_REPLACE_BASIC_ANNUAL
DODO_PRODUCT_PRO_MONTHLY=pdt_REPLACE_PRO_MONTHLY
DODO_PRODUCT_PRO_ANNUAL=pdt_REPLACE_PRO_ANNUAL

# Optional: one-time top-up product for when a customer runs out
# of conversions before their renewal date.
DODO_PRODUCT_REFILL=
REFILL_QUOTA_BONUS=500

# ==============================
# PLAN LIMITS
# (shared conversions per billing period; NOT per machine)
# ==============================

QUOTA_BASIC_MONTHLY=10
QUOTA_BASIC_ANNUAL=120
QUOTA_PRO_MONTHLY=120
QUOTA_PRO_ANNUAL=1500

# ==============================
# APPLICATION
# ==============================

PRODUCT_CODE=pdf-qbo-converter
API_BASE_URL=https://api.taxpreparertools.com
WEBSITE_URL=https://www.taxpreparertools.com
